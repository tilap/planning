# Google OAuth client (web application type)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Encryption key of the session cookie, at least 32 characters
COOKIE_ENCRYPTION_KEY=

# Development only: set to 1 to browse the app with fake events, without signing in to Google.
# The server refuses to start with it in production.
DEV_FAKE_DATA=

# Google accounts allowed to use the app, comma-separated: they are the admins
ALLOWED_EMAILS=

# Neon connection string: the addresses the admins add in the app are kept there.
# Optional: when empty, only the ALLOWED_EMAILS admins can sign in and the app hides the
# management of the allowed addresses (with DEV_FAKE_DATA=1 it stays on, in memory)
DATABASE_URL=

# Public origin of the app; the OAuth redirect URI is <APP_URL>/api/auth/callback
APP_URL=http://localhost:3000
