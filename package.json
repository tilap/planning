{
	"name": "planning",
	"version": "0.0.0",
	"description": "A read-only mobile PWA that shows the events of several Google calendars in one list, readable offline.",
	"license": "MIT",
	"author": "Julien LA VINH",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tilap/planning.git"
	},
	"bugs": "https://github.com/tilap/planning/issues",
	"homepage": "https://github.com/tilap/planning#readme",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@9.15.9",
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"dev": "next dev --turbopack",
		"build": "next build --turbopack",
		"start": "next start",
		"lint": "biome ci .",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"e2e": "pnpm build && playwright test",
		"icons": "node scripts/generate-app-icons.mjs"
	},
	"dependencies": {
		"@neondatabase/serverless": "1.2.1",
		"@t3-oss/env-core": "0.13.11",
		"idb": "8.0.4",
		"next": "16.4.6",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.8",
		"@playwright/test": "1.65.1",
		"@tailwindcss/postcss": "4.3.5",
		"@toolmesh/agent-deck": "0.1.1",
		"@types/node": "26.6.6",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"jsdom": "31.0.1",
		"sharp": "0.34.5",
		"tailwindcss": "4.3.5",
		"typescript": "7.0.2",
		"vitest": "5.1.1"
	}
}
